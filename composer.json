{
  "name": "dominservice/laravel-fingerprint-tracking",
  "description": "Browser fingerprint and interaction tracking for Laravel, with form event correlation and optional invis-captcha integration.",
  "type": "library",
  "keywords": ["laravel", "browser-fingerprinting", "event-tracking", "forms"],
  "homepage": "https://github.com/dominservice/laravel-fingerprint-tracking",
  "license": "MIT",
  "authors": [
    {
      "name": "Mateusz Domin",
      "email": "biuro@dominsoftware.it",
      "homepage": "https://dominsoftware.it/"
    }
  ],
  "support": {
    "source": "https://github.com/dominservice/laravel-fingerprint-tracking",
    "issues": "https://github.com/dominservice/laravel-fingerprint-tracking/issues"
  },
  "require": {
    "php": "^8.1",
    "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "jenssegers/agent": "^2.6"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^10.5|^11.5|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Dominservice\\FingerprintTracking\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Dominservice\\FingerprintTracking\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Dominservice\\FingerprintTracking\\FingerprintTrackingServiceProvider"
      ]
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php vendor/bin/testbench package:discover --ansi"
    ],
    "test": [
      "@php vendor/bin/phpunit --colors=always"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
